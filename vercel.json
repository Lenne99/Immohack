{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "crons": [
    {
      "path": "/api/crawl",
      "schedule": "*/15 * * * *"
    }
  ],
  "env": {
    "CRON_SECRET": "@cron_secret"
  }
}
